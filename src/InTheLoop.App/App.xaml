<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:InTheLoop.App.Converters"
             x:Class="InTheLoop.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:EqualsConverter x:Key="Equals" />
            <converters:HasValueConverter x:Key="HasValue" />
            <converters:StageColorConverter x:Key="StageColor" />
            <converters:EntryKindColorConverter x:Key="EntryKindColor" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
