<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InTheLoop.App.ViewModels"
             x:Class="InTheLoop.App.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">

    <Border Style="{StaticResource Panel}">
        <ScrollView>
            <Grid ColumnDefinitions="*,340" ColumnSpacing="28" Padding="32,28" MaximumWidthRequest="1180" HorizontalOptions="Start">

                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Connect an AI" Style="{StaticResource Title}" />
                        <Label Text="In The Loop ships with an MCP server. Add it to your AI client once, then ask the AI to show you its work."
                               Style="{StaticResource Muted}"
                               FontSize="14" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource DangerSoft}" Padding="16,12" IsVisible="{Binding ServerMissing}">
                        <Label Text="The MCP server (intheloop-mcp.exe) was not found next to the app. Build the solution, then replace the placeholder path below."
                               TextColor="{StaticResource Danger}" />
                    </Border>

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Options}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConnectOption">
                                <Border Style="{StaticResource Card}" Padding="18,16">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" Style="{StaticResource Heading}" />
                                                <Label Text="{Binding Description}" Style="{StaticResource Muted}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1"
                                                    Text="{Binding CopyLabel}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    HeightRequest="36"
                                                    WidthRequest="88"
                                                    VerticalOptions="Start"
                                                    Command="{Binding CopyCommand}" />
                                        </Grid>
                                        <Border BackgroundColor="{StaticResource Stage}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="14,12">
                                            <Label Text="{Binding Snippet}" Style="{StaticResource Code}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="12">
                    <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource AccentSoft}" Padding="18,16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Try it" Style="{StaticResource Heading}" />
                            <Label Text="After connecting, say this to your AI:" Style="{StaticResource Muted}" TextColor="{StaticResource AccentText}" />
                            <Label Text="&quot;Take a screenshot of the page you built and post it to In The Loop for my review.&quot;"
                                   FontSize="14"
                                   LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="What the AI can do" Style="{StaticResource Heading}" />
                            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Tools}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ToolSummary">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}" Style="{StaticResource Code}" />
                                            <Label Text="{Binding Description}" Style="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Border>
</ContentView>
