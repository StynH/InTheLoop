<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InTheLoop.App.ViewModels"
             x:Class="InTheLoop.App.Views.ReviewListView"
             x:DataType="vm:MainViewModel">

    <Border Style="{StaticResource Panel}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="16" Padding="0,22,0,0">

            <VerticalStackLayout Spacing="4" Padding="20,0">
                <Label Text="{Binding Greeting}" Style="{StaticResource Title}" />
                <Label Text="{Binding Summary}" Style="{StaticResource Muted}" />
            </VerticalStackLayout>

            <!-- Project switcher -->
            <FlexLayout Grid.Row="1"
                        Wrap="Wrap"
                        Direction="Row"
                        AlignItems="Start"
                        Margin="16,0,16,-8"
                        IsVisible="{Binding HasProjects}"
                        BindableLayout.ItemsSource="{Binding Projects}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectChipViewModel">
                        <Border BackgroundColor="{StaticResource SurfaceRaised}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999"
                                Padding="12,6"
                                Margin="4,0,4,8"
                                AutomationId="{Binding Name, StringFormat='Project:{0}'}"
                                ToolTipProperties.Text="{Binding Description}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectProjectCommand, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, x:DataType=vm:MainViewModel}"
                                                      CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding Name}" FontSize="13" FontFamily="{StaticResource FontSemibold}" TextColor="{StaticResource TextMuted}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border BackgroundColor="{StaticResource AccentSoft}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 999"
                                        Padding="6,0"
                                        MinimumWidthRequest="18"
                                        HeightRequest="18"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding HasBadge}">
                                    <Label Text="{Binding YourTurnCount}" FontSize="11" FontFamily="{StaticResource FontSemibold}" TextColor="{StaticResource AccentText}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- Counters that double as filters -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8" Padding="20,0">

                <Border BackgroundColor="{StaticResource AccentSoft}"
                        Stroke="Transparent"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        Padding="12,10"
                        AutomationId="FilterYourTurn">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=YourTurn}"
                                     Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Accent}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" CommandParameter="YourTurn" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{Binding YourTurnCount}" FontSize="24" FontFamily="{StaticResource FontSemibold}" TextColor="{StaticResource AccentText}" />
                        <Label Text="Your turn" Style="{StaticResource Caption}" TextColor="{StaticResource AccentText}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource WarningSoft}"
                        Stroke="Transparent"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        Padding="12,10"
                        AutomationId="FilterWithAi">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=WithAi}"
                                     Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Warning}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" CommandParameter="WithAi" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{Binding WithAiCount}" FontSize="24" FontFamily="{StaticResource FontSemibold}" TextColor="{StaticResource Warning}" />
                        <Label Text="With the AI" Style="{StaticResource Caption}" TextColor="{StaticResource Warning}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2"
                        BackgroundColor="{StaticResource SuccessSoft}"
                        Stroke="Transparent"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 16"
                        Padding="12,10"
                        AutomationId="FilterApproved">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Approved}"
                                     Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Success}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" CommandParameter="Approved" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{Binding ApprovedCount}" FontSize="24" FontFamily="{StaticResource FontSemibold}" TextColor="{StaticResource Success}" />
                        <Label Text="Approved" Style="{StaticResource Caption}" TextColor="{StaticResource Success}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Search -->
            <Border Grid.Row="3" Style="{StaticResource Card}" StrokeShape="RoundRectangle 12" Padding="14,0" Margin="20,0" HeightRequest="42">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="14" />
                    <Entry Grid.Column="1"
                           Text="{Binding SearchText}"
                           Placeholder="Search reviews"
                           VerticalOptions="Center"
                           AutomationId="SearchBox" />
                </Grid>
            </Border>

            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="20,0,14,0" HeightRequest="28">
                <Label Text="{Binding ListTitle}" Style="{StaticResource Caption}" VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                <Button Grid.Column="1"
                        Text="&#xE74D;"
                        Style="{StaticResource IconButton}"
                        FontSize="12"
                        WidthRequest="28"
                        HeightRequest="28"
                        CornerRadius="8"
                        Command="{Binding DeleteProjectCommand}"
                        IsVisible="{Binding CanDeleteProject}"
                        AutomationId="DeleteProject"
                        ToolTipProperties.Text="Delete this project (its reviews are kept)" />
            </Grid>

            <CollectionView Grid.Row="5"
                            ItemsSource="{Binding Reviews}"
                            SelectionMode="None"
                            Margin="10,-8,10,0"
                            IsVisible="{Binding IsListEmpty, Converter={StaticResource Equals}, ConverterParameter=False}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewItemViewModel">
                        <Grid Padding="0,3">
                            <Border BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="10">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
                                        <Setter Property="Stroke" Value="{StaticResource Stroke}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCommand, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, x:DataType=vm:MainViewModel}"
                                                          CommandParameter="{Binding}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="68,*" ColumnSpacing="12">
                                    <Border BackgroundColor="{StaticResource Stage}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            HeightRequest="56"
                                            VerticalOptions="Start">
                                        <Image Source="{Binding ThumbnailPath}" Aspect="AspectFill" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Title}"
                                                   FontFamily="{StaticResource FontSemibold}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                            <Label Grid.Column="1" Text="{Binding TimeLabel}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding Preview}"
                                               Style="{StaticResource Muted}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                            <Border Style="{StaticResource Chip}"
                                                    Padding="8,2"
                                                    BackgroundColor="{Binding Stage, Converter={StaticResource StageColor}, ConverterParameter=Soft}">
                                                <Label Text="{Binding StatusLabel}"
                                                       FontSize="11"
                                                       FontFamily="{StaticResource FontSemibold}"
                                                       TextColor="{Binding Stage, Converter={StaticResource StageColor}}" />
                                            </Border>
                                            <Label Text="{Binding RevisionLabel}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                            <Label Text="{Binding Context}"
                                                   Style="{StaticResource Caption}"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   MaximumWidthRequest="110" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Grid.Row="5"
                   Text="{Binding EmptyListText}"
                   Style="{StaticResource Muted}"
                   IsVisible="{Binding IsListEmpty}"
                   Margin="20,8"
                   VerticalOptions="Start" />
        </Grid>
    </Border>
</ContentView>
